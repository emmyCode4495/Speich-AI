{
  "name": "speich-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Live speech-to-speech voice changer powered by ElevenLabs STS",
  "workspaces": ["electron", "server", "shared"],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:electron": "npm run dev --workspace=electron",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:electron\"",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
