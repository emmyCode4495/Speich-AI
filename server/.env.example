PORT=3850
NODE_ENV=development
PUBLIC_API_URL=https://your-speich-api.onrender.com

# Required
AUTH_SECRET=change_me_to_long_random_string_min_32_chars
ELEVENLABS_API_KEY=sk_your_elevenlabs_key
# Default STS model (check ElevenLabs docs for voice-conversion capable models)
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# Optional: seed free seconds for testing (0 in production)
SIGNUP_BONUS_SECONDS=60

# Postgres (Supabase connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Payments — wire same as Morphly when ready
# NOWPAYMENTS_API_KEY=
# FLW_SECRET_KEY=
# PUBLIC_API_URL=...
